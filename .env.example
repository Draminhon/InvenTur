# ============================================================================
# SisTur — configuração do SERVIDOR (Django)
# Copie este arquivo para ".env" e preencha os valores. O ".env" NUNCA deve ir para o git
# nem para o aplicativo. Variáveis de ambiente do sistema têm prioridade sobre o arquivo.
# ============================================================================

# --- Segurança (obrigatórias) ----------------------------------------------
# Gerar:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# ATENÇÃO: também é usada no índice de busca de e-mails; trocá-la exige recalcular os índices.
DJANGO_SECRET_KEY=

# Chave Fernet que criptografa os dados pessoais no banco.
# Gerar:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENÇÃO: trocá-la sem re-criptografar o banco torna os dados existentes ilegíveis.
FIELD_ENCRYPTION_KEY=

# --- Execução -----------------------------------------------------------------
# Em produção, SEMPRE False (com True, erros exibem detalhes internos do sistema)
DJANGO_DEBUG=False
# Domínios atendidos pelo servidor, separados por vírgula
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Endereços completos com https, separados por vírgula (necessário para entrar no painel /admin/)
CSRF_TRUSTED_ORIGINS=
# Proxies na frente do Django: 0 em desenvolvimento; 1 atrás de nginx ou no PythonAnywhere.
# Errado aqui = todos os usuários parecem ter o mesmo IP e o bloqueio de login atinge todo mundo.
DJANGO_NUM_PROXIES=0
# Redireciona http -> https (deixe False se o servidor web/proxy já faz isso)
DJANGO_SECURE_SSL_REDIRECT=False

# --- CORS (origens web autorizadas a chamar a API) ---------------------------
CORS_ALLOWED_ORIGINS=https://nupreds.ifce.edu.br
# Em produção, prefira False e liste as origens acima
CORS_ALLOW_ALL_ORIGINS=False

# --- Banco de dados -------------------------------------------------------------
# Padrão: SQLite local. Para PostgreSQL: DB_ENGINE=django.db.backends.postgresql
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- E-mail (recuperação de senha) -------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Recomendado: conta institucional do tipo "não-responda"
EMAIL_HOST_USER=
# Para Gmail: "senha de app" (não a senha da conta)
EMAIL_HOST_PASSWORD=
# Remetente exibido nos e-mails (padrão: EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=

# --- Sessão (JWT) ---------------------------------------------------------------
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7
