# ============================================================================
# SisTur — configuração do APP (Flutter)
# Copie este arquivo para "app.env", preencha e rode/compile com:
#   flutter run --dart-define-from-file=app.env
#   flutter build apk --dart-define-from-file=app.env
# ATENÇÃO: tudo aqui fica embutido no aplicativo e pode ser extraído do APK.
# NUNCA coloque segredos do servidor (chaves, senhas) neste arquivo.
# ============================================================================

# Endereço da API
#   Emulador Android (servidor local): http://10.0.2.2:8000/api/v1/
#   Produção:                          https://nupreds.ifce.edu.br/inventur/api/v1/
API_BASE_URL=http://10.0.2.2:8000/api/v1/

# Token PÚBLICO do Mapbox (começa com "pk."). Restrinja-o no painel do Mapbox.
API_TOKEN_MAPBOX=
